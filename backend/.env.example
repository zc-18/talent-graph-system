# ===== 智岗图谱 TalentGraph AI · 环境变量示例 =====
# 复制本文件为 backend/.env 并填入真实值（.env 已被 .gitignore 忽略，切勿提交）

# 数据库连接（MySQL）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
# data/*.py 一律写入这里指向的库，且直接绕过只读闸门——跑数据脚本前务必确认，
# 否则会静默写错库。三个库的分工：
#   talent_graph      最初的演示库，也是 config.py 的缺省值。示例文件刻意停在这里：
#                     从 .env.example 复制出来的环境不该默认握着生产库的写权限。
#   talent_graph_v2   上一轮图谱，保留作回滚目标，勿动。
#   talent_graph_v3   **当前生产图谱**——线上服务读的就是它。要重建/演化生产数据时，
#                     显式改这一行，或临时 $env:DB_NAME='talent_graph_v3'（PowerShell）。
DB_NAME=talent_graph

# DeepSeek 大模型（OpenAI 兼容）
DEEPSEEK_API_KEY=sk-your_deepseek_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Tavily 联网检索（用于交叉验证/证据采集）
TAVILY_API_KEY=tvly-your_tavily_key

# Serper.dev Google 检索（第二独立来源，交叉验证）
SERPER_API_KEY=your_serper_key

# BGE 向量嵌入服务（语义匹配 / 去重 / RAG 接地，512 维）
EMBED_API_KEY=sk-your_embed_key
EMBED_BASE_URL=http://127.0.0.1:7001/v1
EMBED_MODEL=bge-small-zh-v1.5
EMBED_DIM=512

# 应用配置
APP_PORT=8200
CORS_ORIGINS=*

# 演示站只读开关（见 app/guards.py）。1 = 关闭一切改动图谱的写操作：
# 人工增删改能力项、简历入库直接 403；演化推演与新岗位发现降级为 dry-run
# （照常跑完 LLM/检索/聚合并返回结果，只是不落库）；查询、简历解析、人岗匹配、
# 问答助手不受影响。**公网部署必须置 1**——线上两次图谱事故都是访客点击写接口造成的。
# 闸门只设在 HTTP 层，data/*.py 直接调服务层写库、不受影响：发布数据仍走本地脚本，
# 这也正是设计意图——公网只读，发布权留在本地。
READ_ONLY=0
